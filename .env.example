# Copy this file to .env and adjust values for your setup.
# All settings are optional — the application uses these defaults if .env is absent.

# Maximum number of tiles to use from the library index
NUM_TILES=300000

# Base tile size in pixels (render placement grid — NOT the stored tile size)
TILE_SIZE=75

# Resolution at which the downloader fetches source tiles (px). Kept separate
# from TILE_SIZE so tiles stay sharp when a mosaic cell is larger than 75 px
# (high tile_scale). 512 gives headroom to tile_scale ~5.
DOWNLOAD_SIZE=512

# Max short side (px) the optimiser downscales tiles to, IN-PLACE (destructive).
# Was 250 historically, which softened the library. Recovery for an already-
# shrunk library: python -m src.tools.upgrade_tiles (re-fetches COCO at full res
# into the data/tiles_hires overlay).
OPTIMIZER_SHORT_SIDE=512

# Short side of the output mosaic in pixels (determines resolution)
# 4K  ≈  4320  |  8K  ≈  8640  |  16K  ≈  18000
TARGET_SHORT_SIDE=18000

# Ghosting overlay opacity (0.0 = pure mosaic, 1.0 = original image fully visible)
GHOSTING_OPACITY=0.25

# Set to True to use CUDA GPU acceleration, False to force CPU
USE_CUDA=True

# Openverse API credentials (optional — increases rate limits significantly)
# Register at: https://api.openverse.org/v1/auth_tokens/register/
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
